# Base de datos
DATABASE_URL=postgresql://inmueblecheck:dev_password_2024@postgres:5432/inmueblecheck

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production

# Puerto
PORT=4311
NODE_ENV=development

# WhatsApp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Cifrado de credenciales WhatsApp
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENC_KEY=generate_random_32_byte_hex_key_here

# IA (opcional - para bot)
AI_PROVIDER=simulado
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here

# Zona horaria
TZ=America/Mexico_City
